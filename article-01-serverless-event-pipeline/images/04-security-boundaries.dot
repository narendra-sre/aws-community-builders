digraph Security {
  graph [rankdir=LR, compound=true, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65", label="Figure 4. Security boundaries and least-privilege access", labelloc=t, fontsize=20, fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.16,0.12", color="#3467A8", fillcolor="#EDF4FF", fontcolor="#142B4C", penwidth=1.4];
  edge [fontname="Arial", fontsize=9, color="#52647A", fontcolor="#27364B", penwidth=1.3, arrowsize=0.75];
  subgraph cluster_storage { label="Storage and event source"; color="#9DB9E8"; style="rounded"; S3 [label="Amazon S3 bucket\nBlock Public Access\nEncryption + versioning", shape=cylinder]; }
  subgraph cluster_msg { label="Messaging"; color="#9DB9E8"; Q [label="SQS processing queue"]; DLQ [label="SQS dead-letter queue", fillcolor="#FFF0EF", color="#C2413B", fontcolor="#4A1212"]; POL [label="Queue policy\nAllow intended S3 source only"]; }
  subgraph cluster_compute { label="Compute identity boundary"; color="#C4A7E8"; L [label="AWS Lambda processor", fillcolor="#F3E8FF", color="#7E22CE", fontcolor="#3B0764"]; ROLE [label="IAM execution role\nPoll/delete queue messages\nWrite CloudWatch logs", fillcolor="#F3E8FF", color="#7E22CE", fontcolor="#3B0764"]; }
  CW [label="CloudWatch Logs", fillcolor="#E8F8F1", color="#16845B", fontcolor="#103D2B"];
  S3 -> Q [label="Object-created event"];
  Q -> L [label="Poll / process"];
  Q -> DLQ [label="Repeated failure", style=dashed, color="#C2413B"];
  POL -> Q [label="Restricts publisher", style=dotted];
  ROLE -> L [label="Grants minimum actions", style=dotted];
  L -> CW [label="Execution logs"];
}
