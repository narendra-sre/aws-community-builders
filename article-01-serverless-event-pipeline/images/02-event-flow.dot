digraph EventFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.5", label="Figure 2. Event processing sequence", labelloc=t, fontsize=20, fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.18,0.12", color="#2F6FDB", fillcolor="#E8F2FF", fontcolor="#12213A", penwidth=1.4];
  edge [fontname="Arial", fontsize=10, color="#52647A", fontcolor="#27364B", penwidth=1.4, arrowsize=0.8];
  A [label="1. User uploads object", fillcolor="#F4F7FB", color="#64748B"];
  B [label="2. S3 publishes event notification"];
  C [label="3. SQS buffers the message"];
  D [label="4. Lambda polls and receives a batch", fillcolor="#FFF0E6", color="#D97706", fontcolor="#41210A"];
  E [label="5. Validate and process each record", fillcolor="#FFF0E6", color="#D97706", fontcolor="#41210A"];
  F [label="6. Write execution logs", fillcolor="#E8F8F1", color="#16845B", fontcolor="#103D2B"];
  G [label="7. Acknowledge successes; retry failures", fillcolor="#F3E8FF", color="#7E22CE", fontcolor="#3B0764"];
  A -> B -> C -> D -> E -> G;
  E -> F [label="Observability"];
}
