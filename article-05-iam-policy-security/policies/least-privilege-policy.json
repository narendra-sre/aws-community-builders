{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadWriteObjectsInTelemetryPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::article05-demo-bucket/telemetry/*"
    },
    {
      "Sid": "AllowListOnlyTelemetryPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::article05-demo-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "telemetry/",
            "telemetry/*"
          ]
        }
      }
    },
    {
      "Sid": "ExplicitlyDenyBucketDestruction",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::article05-demo-bucket"
    }
  ]
}
