{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllActionsOnAllResources",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "SensitiveIAMActionsOnAllResources",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
